.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Never commit collected quotes. They are derived from real identities and,
# where vendor-sourced, licensed -- redistribution terms almost certainly
# prohibit it.
data/raw/*
data/interim/*
data/processed/*
!data/**/.gitkeep
data/geo/*
!data/geo/.gitkeep

# CatBoost scratch output
catboost_info/

# Local run logs
*.log
